{{!-- Cargo/inventory presentation for the dedicated grenade Item type. --}}
{{#if inventory.grenades.length}}
<section class="inventory-section grenade-section">
    <div class="section-header inv-section-header">
        <span>{{localize "NEUROSHIMA.Items.Type.Grenade"}}</span>
        <div class="item-stat quantity text-center">{{localize "NEUROSHIMA.Items.Fields.Quantity"}}</div>
        {{#if enableEncumbrance}}
        <div class="item-stat weight text-center">{{localize "NEUROSHIMA.Items.Fields.Weight"}}</div>
        {{/if}}
        <div class="item-controls">
            <a class="item-control" data-action="createItem" data-type="grenade" title="{{localize 'NEUROSHIMA.Actions.AddItem' type=(localize 'NEUROSHIMA.Items.Type.Grenade')}}"><i class="fas fa-plus"></i></a>
        </div>
    </div>
    <div class="inventory-list grenade-list">
        <div class="inventory-items">
            {{#each inventory.grenades as |item|}}
            <div class="item-wrap" data-item-id="{{item.id}}" data-uuid="{{item.uuid}}">
                <div class="item draggable flexrow" data-item-id="{{item.id}}" data-uuid="{{item.uuid}}" draggable="true">
                    <div class="item-name flex3">
                        <div class="item-image" style="background-image: url('{{item.img}}')" data-action="toggleSummary" data-item-preview-html="{{lookup @root.itemPreviewTooltips item.id}}" data-item-preview-direction="RIGHT"></div>
                        <span class="name clickable" data-action="toggleSummary">{{item.name}}</span>
                    </div>
                    <div class="item-stat quantity quantity-controls"><span class="quantity-value">{{item.system.quantity}}</span></div>
                    {{#if ../enableEncumbrance}}
                    <div class="item-stat weight text-center"><span class="weight-value">{{item.system.totalWeight}}</span></div>
                    {{/if}}
                    <div class="item-controls">
                        <a class="item-control item-ctx-btn" data-action="itemContextMenu" title="{{localize 'NEUROSHIMA.ContextMenu.Options'}}"><i class="fa-solid fa-ellipsis-vertical"></i></a>
                    </div>
                </div>
                <div class="item-summary collapsed">
                    <div class="item-description">{{{lookup @root.itemDescriptions item.id}}}</div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>
{{/if}}
