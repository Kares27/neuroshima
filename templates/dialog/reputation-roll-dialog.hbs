<div class="roll-dialog-content reputation-roll-dialog-content">

    <input type="hidden" name="testMode" value="{{testMode}}"/>

    <div class="rd-top-split">
        <div class="rd-inputs-col">
            <div class="form-group">
                <label>{{localize "NEUROSHIMA.Roll.Modifier"}} (%)</label>
                <input type="number" name="modifier" value="{{modifier}}" placeholder="0"/>
            </div>
            <div class="form-group">
                <label data-tooltip="{{localize 'NEUROSHIMA.Reputation.RepBonusHint'}}">
                    {{localize "NEUROSHIMA.Reputation.RepBonus"}}
                </label>
                <input type="number" name="repBonus" value="{{repBonus}}" placeholder="0"/>
            </div>
            <div class="form-group">
                <label title="{{localize 'NEUROSHIMA.Reputation.Value'}}">
                    {{localize "NEUROSHIMA.Reputation.ValueAbbr"}}
                </label>
                <input type="number" value="{{repValue}}" data-reputation-field="value" disabled/>
            </div>
            <div class="form-group">
                <label title="{{localize 'NEUROSHIMA.Reputation.Fame'}}">
                    {{localize "NEUROSHIMA.Reputation.FameAbbr"}}
                </label>
                <input type="number" value="{{fame}}" data-reputation-field="fame" disabled/>
            </div>
        </div>

        <div class="rd-modifiers-col">
            <div class="rd-modifiers-panel">
                <h4 class="dialog-modifiers-header">{{localize "NEUROSHIMA.Roll.DialogModifiers"}}</h4>
                <ul class="dm-modifier-list">
                    {{#each dialogModifiers}}
                    <li class="dm-modifier-item {{#if canToggle}}dm-toggleable{{/if}} {{#if activated}}dm-active{{/if}}"
                        data-action="clickModifier"
                        data-dm-index="{{@index}}"
                        data-dm-effect-id="{{_effectId}}"
                        {{#if description}}data-tooltip="{{description}}" data-tooltip-direction="DOWN"{{/if}}>
                        <span class="dm-bullet">•</span><a>{{label}}</a>
                    </li>
                    {{else}}
                    <li class="dm-modifier-empty">—</li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>

    {{#if isSkillMode}}
    <div class="rd-dropdowns-row">
        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Roll.Test"}}</label>
            <select name="isOpen">
                <option value="true" {{#if isOpen}}selected{{/if}}>{{localize "NEUROSHIMA.Roll.OpenTestShort"}}</option>
                <option value="false" {{#unless isOpen}}selected{{/unless}}>{{localize "NEUROSHIMA.Roll.ClosedTestShort"}}</option>
            </select>
        </div>
        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Roll.Difficulty"}}</label>
            <select name="baseDifficulty">
                {{#each difficulties}}
                <option value="{{@key}}" {{#if (eq @key ../baseDifficulty)}}selected{{/if}}>
                    {{localize label}}
                </option>
                {{/each}}
            </select>
        </div>
    </div>
    {{/if}}

    <div class="rd-rollmode-row">
        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Roll.RollMode"}}</label>
            <select name="rollMode" class="rd-rollmode-select">
                {{selectOptions rollModes selected=rollMode localize=true}}
            </select>
        </div>
    </div>

    <div class="summary-section">
        <h3>{{localize "NEUROSHIMA.Roll.Summary"}}</h3>
        <table class="summary-table">
            <tr>
                <td>{{localize "NEUROSHIMA.Roll.TotalModifier"}}</td>
                <td class="rep-total-modifier">0%</td>
            </tr>
            {{#if isSkillMode}}
            <tr>
                <td>{{localize "NEUROSHIMA.Roll.FinalDifficulty"}}</td>
                <td class="rep-final-difficulty">-</td>
            </tr>
            {{/if}}
            <tr>
                <td>{{localize "NEUROSHIMA.Roll.Target"}}</td>
                <td class="rep-final-target">-</td>
            </tr>
        </table>
    </div>

    {{#if isSimpleMode}}
    <p class="hint reputation-simple-hint">{{localize "NEUROSHIMA.Reputation.SimpleRollHint"}}</p>
    {{/if}}

    <footer class="form-footer">
        <button type="button" data-action="roll" autofocus>
            <i class="fas fa-dice-d20"></i>
            <span>{{localize "NEUROSHIMA.Actions.Roll"}}</span>
        </button>
        <button type="button" data-action="cancel">
            <i class="fas fa-times"></i>
            <span>{{localize "NEUROSHIMA.Actions.Cancel"}}</span>
        </button>
    </footer>
</div>
