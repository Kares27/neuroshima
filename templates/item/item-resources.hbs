<section class="tab resources {{tabs.resources.cssClass}}" data-group="primary" data-tab="resources" data-application-part="resources">
    <div class="section-header">
        <div class="header-title">
            <i class="fas fa-bolt"></i>
            <span>Użycie</span>
        </div>
        {{#if supportsActivities}}{{#if editable}}<div class="header-actions">
            <button type="button" data-action="createActivity" title="Nowa aktywność"><i class="fas fa-plus"></i></button>
        </div>{{/if}}{{/if}}
    </div>

    {{#if supportsActivities}}
    <div class="usage-subsection-header activity-list-heading">
        <span>Aktywności</span>
    </div>
    <div class="item-activities-list">
        {{#each activities}}
        <article class="item-activity-row" data-activity-id="{{id}}">
            <button type="button" class="activity-row-main" data-action="editActivity" data-activity-id="{{id}}">
                <img src="{{img}}" alt="">
                <span><strong>{{name}}</strong><small>{{typeLabel}}</small></span>
            </button>
            {{#unless (eq remaining null)}}<span class="activity-uses-badge">{{remaining}} / {{uses.max}}</span>{{/unless}}
            <button type="button" class="activity-use-button" data-action="useActivity" data-activity-id="{{id}}" {{#unless canUse}}disabled{{/unless}} data-tooltip="Użyj">
                <i class="fas fa-play"></i>
            </button>
        </article>
        {{else}}<p class="empty-list">Ten Item nie ma jeszcze żadnej aktywności.</p>{{/each}}
    </div>
    {{/if}}
</section>
