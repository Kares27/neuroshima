<div class="flexcol" style="gap: 8px;">
    {{#if isLauncher}}
    <div class="secondary-box grid grid-3col">
        <div class="form-group row-group">
            <label>{{localize "NEUROSHIMA.Items.Fields.LauncherType"}}</label>
            <select name="system.launcherType">
                <option value="grenade" {{#if (eq system.launcherType "grenade")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Type.Grenade"}}</option>
                <option value="rocket" {{#if (eq system.launcherType "rocket")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Type.Rocket"}}</option>
                <option value="mortar" {{#if (eq system.launcherType "mortar")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Type.Mortar"}}</option>
                <option value="other" {{#if (eq system.launcherType "other")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Type.Other"}}</option>
            </select>
        </div>
        <div class="form-group row-group">
            <label>{{localize "NEUROSHIMA.Items.Fields.AmmoFeed"}}</label>
            <select name="system.ammoFeed">
                <option value="direct" {{#if (eq system.ammoFeed "direct")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Feed.Direct"}}</option>
                <option value="magazine" {{#if (eq system.ammoFeed "magazine")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Feed.Magazine"}}</option>
                <option value="either" {{#if (eq system.ammoFeed "either")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Feed.Either"}}</option>
                <option value="integrated" {{#if (eq system.ammoFeed "integrated")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Feed.Integrated"}}</option>
            </select>
        </div>
        {{#if (eq system.ammoFeed "either")}}
        <div class="form-group row-group">
            <label>{{localize "NEUROSHIMA.Items.Fields.AmmoFeedMode"}}</label>
            <select name="system.ammoFeedMode">
                <option value="direct" {{#if (eq system.ammoFeedMode "direct")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Feed.Direct"}}</option>
                <option value="magazine" {{#if (eq system.ammoFeedMode "magazine")}}selected{{/if}}>{{localize "NEUROSHIMA.Items.Launcher.Feed.Magazine"}}</option>
            </select>
        </div>
        {{/if}}
    </div>
    {{/if}}
    {{!-- Atrybut, Umiejętność, Mod Broni (3 kolumny obok siebie) --}}
    <div class="secondary-box">
        <div class="grid grid-4col">
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.Attribute"}}</label>
                <select name="system.attribute">
                    {{selectOptions attributes selected=system.attribute labelAttr="label" localize=true}}
                </select>
            </div>
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.Skill"}}</label>
                <select name="system.skill">
                    {{selectOptions availableSkills selected=system.skill localize=true}}
                </select>
            </div>
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.DamageType"}}</label>
                <select name="system.damageCategory" {{#if isModded}}disabled{{/if}}>
                    {{#each damageCategories as |cat key|}}
                    <option value="{{key}}" {{#if (eq ../system.damageCategory key)}}selected{{/if}}>{{localize cat.label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="form-group row-group">
                <label title="{{localize 'NEUROSHIMA.Items.Fields.WeaponModifier'}}">{{localize "NEUROSHIMA.Items.Fields.WeaponModifierAbbr"}}</label>
                <input type="number" name="system.weaponModifier" value="{{system.weaponModifier}}" data-dtype="Number" {{#if isModded}}disabled{{/if}}/>
            </div>
        </div>
    </div>

    {{!-- Row 1 + Row 2: Statystyki broni --}}
    <div class="secondary-box flexcol" style="gap: 8px;">
        {{!-- Row 1: Typ Broni, Typ Amunicji, Obrażenia, PP, Szybkostrzelność --}}
        <div class="grid grid-5col">
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.WeaponSubtype"}}</label>
                <select name="system.rangedSubtype" {{#if isModded}}disabled{{/if}}>
                    {{selectOptions weaponSubtypes.ranged selected=system.rangedSubtype localize=true}}
                </select>
            </div>
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.Caliber"}}</label>
                <input type="text" name="system.caliber" value="{{system.caliber}}" list="caliber-list-{{item.id}}" {{#if isModded}}disabled{{/if}}/>
                <datalist id="caliber-list-{{item.id}}">
                    {{#each worldCalibers as |caliber|}}
                    <option value="{{caliber}}"></option>
                    {{/each}}
                </datalist>
            </div>
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.Damage"}}</label>
                <select name="system.damage" {{#if isModded}}disabled{{/if}}>
                    {{selectOptions damageTypes selected=system.damage localize=true}}
                </select>
            </div>
            <div class="form-group row-group">
                <label title="{{localize 'NEUROSHIMA.Items.Fields.Piercing'}}">{{localize "NEUROSHIMA.Items.Fields.PiercingAbbr"}}</label>
                <input type="number" name="system.piercing" value="{{system.piercing}}" data-dtype="Number" min="0" {{#if isModded}}disabled{{/if}}/>
            </div>
            <div class="form-group row-group">
                <label title="{{localize 'NEUROSHIMA.Items.Fields.FireRate'}}">{{localize "NEUROSHIMA.Items.Fields.FireRateAbbr"}}</label>
                <input type="number" name="system.fireRate" value="{{system.fireRate}}" data-dtype="Number" min="0" {{#if isModded}}disabled{{/if}}/>
            </div>
        </div>

        {{!-- Row 2: Pojemność, Zacięcie, Budowa, Bonus do ataku, Bonus do Obrony --}}
        <div class="grid grid-5col">
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.Capacity"}}</label>
                <input type="number" name="system.capacity" value="{{system.capacity}}" data-dtype="Number" min="0" {{#if isModded}}disabled{{/if}}/>
            </div>
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.Jamming"}}</label>
                <input type="number" name="system.jamming" value="{{system.jamming}}" data-dtype="Number" min="0" max="20" {{#if isModded}}disabled{{/if}}/>
            </div>
            <div class="form-group row-group">
                <label>{{localize "NEUROSHIMA.Items.Fields.RequiredBuild"}}</label>
                <input type="number" name="system.requiredBuild" value="{{system.requiredBuild}}" data-dtype="Number" min="0" {{#if isModded}}disabled{{/if}}/>
            </div>
            <div class="form-group row-group">
                <label title="{{localize 'NEUROSHIMA.Items.Fields.AttackBonus'}}">{{localize "NEUROSHIMA.Items.Fields.AttackBonusAbbr"}}</label>
                <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" data-dtype="Number" {{#if isModded}}disabled{{/if}}/>
            </div>
            <div class="form-group row-group">
                <label title="{{localize 'NEUROSHIMA.Items.Fields.DefenseBonus'}}">{{localize "NEUROSHIMA.Items.Fields.DefenseBonusAbbr"}}</label>
                <input type="number" name="system.defenseBonus" value="{{system.defenseBonus}}" data-dtype="Number" {{#if isModded}}disabled{{/if}}/>
            </div>
        </div>

        {{!-- "Wszystkie" is an override; disabled individual values remain stored. --}}
        {{#unless isLauncher}}<fieldset class="fire-modes-section">
            <legend>{{localize "NEUROSHIMA.Items.Fields.FireModes"}}</legend>
            <div class="fire-modes-table">
                <div class="fire-mode-column fire-mode-all-column">
                    <label class="fire-mode-checkbox fire-mode-all">
                        <input type="checkbox" name="system.fireModes.all" {{checked system.fireModes.all}}/>
                        <span class="fire-mode-label">{{localize "NEUROSHIMA.Items.Fields.FireModeAll"}}</span>
                    </label>
                    <div class="fire-mode-modifier-label">{{localize "NEUROSHIMA.Items.Fields.FireModeModifiers"}}</div>
                </div>
                <div class="fire-mode-column">
                    <label class="fire-mode-checkbox">
                        <input type="checkbox" name="system.fireModes.single" {{checked system.fireModes.single}} {{#if system.fireModes.all}}disabled{{/if}}/>
                        <span class="fire-mode-label">{{localize "NEUROSHIMA.Items.Fields.FireModeSingle"}}</span>
                    </label>
                    <div class="fire-mode-modifier-field"><input type="number" name="system.fireModeModifiers.single" value="{{system.fireModeModifiers.single}}" data-dtype="Number" step="1"/></div>
                </div>
                <div class="fire-mode-column">
                    <label class="fire-mode-checkbox">
                        <input type="checkbox" name="system.fireModes.shortBurst" {{checked system.fireModes.shortBurst}} {{#if system.fireModes.all}}disabled{{/if}}/>
                        <span class="fire-mode-label">{{localize "NEUROSHIMA.Items.Fields.FireModeShort"}}</span>
                    </label>
                    <div class="fire-mode-modifier-field"><input type="number" name="system.fireModeModifiers.shortBurst" value="{{system.fireModeModifiers.shortBurst}}" data-dtype="Number" step="1"/></div>
                </div>
                <div class="fire-mode-column">
                    <label class="fire-mode-checkbox">
                        <input type="checkbox" name="system.fireModes.longBurst" {{checked system.fireModes.longBurst}} {{#if system.fireModes.all}}disabled{{/if}}/>
                        <span class="fire-mode-label">{{localize "NEUROSHIMA.Items.Fields.FireModeLong"}}</span>
                    </label>
                    <div class="fire-mode-modifier-field"><input type="number" name="system.fireModeModifiers.longBurst" value="{{system.fireModeModifiers.longBurst}}" data-dtype="Number" step="1"/></div>
                </div>
                <div class="fire-mode-column">
                    <label class="fire-mode-checkbox">
                        <input type="checkbox" name="system.fireModes.fullAuto" {{checked system.fireModes.fullAuto}} {{#if system.fireModes.all}}disabled{{/if}}/>
                        <span class="fire-mode-label">{{localize "NEUROSHIMA.Items.Fields.FireModeFull"}}</span>
                    </label>
                    <div class="fire-mode-modifier-field"><input type="number" name="system.fireModeModifiers.fullAuto" value="{{system.fireModeModifiers.fullAuto}}" data-dtype="Number" step="1"/></div>
                </div>
            </div>
        </fieldset>{{/unless}}
    </div>

    {{!-- Magazynek (na dole) --}}
    {{#if launcherUsesDirect}}
    <div class="secondary-box">
        <div class="form-group row-group">
            <label>{{localize "NEUROSHIMA.Items.Fields.Ammo"}}</label>
            <select name="system.directAmmo">
                <option value="">{{localize "NEUROSHIMA.Items.Fields.None"}}</option>
                {{#each availableAmmo as |ammo|}}<option value="{{ammo.id}}" title="{{ammo.tooltip}}" {{#if (eq ../system.directAmmo ammo.id)}}selected{{/if}}>{{ammo.name}}</option>{{/each}}
            </select>
        </div>
    </div>
    {{/if}}
    {{#if showMagazineSelector}}
    <div class="secondary-box">
        <div class="form-group row-group">
            <label>{{localize "NEUROSHIMA.Items.Fields.Magazine"}}</label>
            <select name="system.magazine">
                <option value="">{{localize "NEUROSHIMA.Items.Fields.None"}}</option>
                {{#each availableMagazines as |mag|}}
                <option value="{{mag.id}}" title="{{mag.tooltip}}" {{#if (eq ../system.magazine mag.id)}}selected{{/if}}>{{mag.name}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    {{/if}}
</div>
