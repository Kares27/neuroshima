<div class="config-section damage-categories-config">
    <h3>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.Title"}}</h3>
    <p class="notes">{{localize "NEUROSHIMA.ArmorLimit.CategoryHint"}}</p>
    <h4>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.BuiltinHeader"}}</h4>
    <table>
        <thead><tr><th>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.ColKey"}}</th><th>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.ColLabel"}}</th><th>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.ColColor"}}</th><th>{{localize "NEUROSHIMA.ArmorLimit.CategoryMax"}}</th><th>{{localize "NEUROSHIMA.Armor.GlobalDamage"}}</th></tr></thead>
        <tbody>{{#each builtinRows as |row|}}<tr data-damage-builtin-row="{{row.key}}">
            <td>{{row.key}}</td><td>{{row.label}}</td><td><span class="damage-category-swatch" style="background:{{row.color}}"></span></td>
            <td><input type="number" data-category-limit name="categoryLimits.{{row.key}}" value="{{row.maxArmor}}" min="0" step="0.5" placeholder="—" aria-label="{{row.label}}"></td>
            <td class="damage-category-global"><input type="checkbox" data-category-global-damage name="categoryGlobalDamage.{{row.key}}" {{checked row.globalDamage}} title="{{localize 'NEUROSHIMA.Armor.GlobalDamageHint'}}" aria-label="{{localize 'NEUROSHIMA.Armor.GlobalDamage'}}"></td>
        </tr>{{/each}}</tbody>
    </table>
    <div class="config-section-heading">
        <h4>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.CustomHeader"}}</h4>
        <button type="button" data-action="addCategoryRow"><i class="fas fa-plus"></i> {{localize "NEUROSHIMA.Settings.DamageCategoryConfig.AddCategory"}}</button>
    </div>
    <table>
        <thead><tr><th>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.ColKey"}}</th><th>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.ColLabel"}}</th><th>{{localize "NEUROSHIMA.Settings.DamageCategoryConfig.ColColor"}}</th><th>{{localize "NEUROSHIMA.ArmorLimit.CategoryMax"}}</th><th>{{localize "NEUROSHIMA.Armor.GlobalDamage"}}</th><th></th></tr></thead>
        <tbody>{{#each customRows as |row|}}<tr data-damage-custom-row="{{row.idx}}">
            <td><input type="text" data-category-key name="custom.{{row.idx}}.key" value="{{row.key}}" placeholder="my_type" aria-label="{{localize 'NEUROSHIMA.Settings.DamageCategoryConfig.ColKey'}}"></td>
            <td><input type="text" data-category-label name="custom.{{row.idx}}.label" value="{{row.label}}" aria-label="{{localize 'NEUROSHIMA.Settings.DamageCategoryConfig.ColLabel'}}"></td>
            <td><input type="color" data-category-color name="custom.{{row.idx}}.color" value="{{row.color}}" aria-label="{{localize 'NEUROSHIMA.Settings.DamageCategoryConfig.ColColor'}}"></td>
            <td><input type="number" data-category-limit name="custom.{{row.idx}}.maxArmor" value="{{row.maxArmor}}" min="0" step="0.5" placeholder="—" aria-label="{{localize 'NEUROSHIMA.ArmorLimit.CategoryMax'}}"></td>
            <td class="damage-category-global"><input type="checkbox" data-category-global-damage name="custom.{{row.idx}}.globalDamage" {{checked row.globalDamage}} title="{{localize 'NEUROSHIMA.Armor.GlobalDamageHint'}}" aria-label="{{localize 'NEUROSHIMA.Armor.GlobalDamage'}}"></td>
            <td><button type="button" data-action="deleteCategoryRow" data-idx="{{row.idx}}" title="{{localize 'NEUROSHIMA.Settings.DamageCategoryConfig.DeleteCategory'}}"><i class="fas fa-trash"></i></button></td>
        </tr>{{/each}}</tbody>
    </table>
</div>
