<section class="neuroshima-config">
    <div class="config-body">
    <div class="config-section">
        <h3>{{localize "NEUROSHIMA.Settings.CombatConfig.Title"}}</h3>
        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.UsePelletCountLimit.Name"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="usePelletCountLimit" {{checked config.usePelletCountLimit}}>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.UsePelletCountLimit.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.AllowCombatShift.Name"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="allowCombatShift" {{checked config.allowCombatShift}}>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.AllowCombatShift.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.AllowPainResistanceShift.Name"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="allowPainResistanceShift" {{checked config.allowPainResistanceShift}}>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.AllowPainResistanceShift.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.FireCorrection.Name"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="fireCorrection" {{checked config.fireCorrection}}>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.FireCorrection.Hint"}}</p>
        </div>
    </div>

    <div class="config-section">
        <h3>{{localize "NEUROSHIMA.MeleeOpposed.Title"}}</h3>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.MeleeCombatType.Name"}}</label>
            <div class="form-fields">
                <select name="meleeCombatType">
                    <option value="default" {{#if (eq config.meleeCombatType "default")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.MeleeCombatType.Default"}}</option>
                    <option value="opposedPips" {{#if (eq config.meleeCombatType "opposedPips")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.MeleeCombatType.OpposedPips"}}</option>
                    <option value="opposedSuccesses" {{#if (eq config.meleeCombatType "opposedSuccesses")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.MeleeCombatType.OpposedSuccesses"}}</option>
                </select>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.MeleeCombatType.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.DoubleSkillAction.Name"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="doubleSkillAction" {{checked config.doubleSkillAction}}>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.DoubleSkillAction.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.MeleeBonusMode.Name"}}</label>
            <div class="form-fields">
                <select name="meleeBonusMode">
                    <option value="attribute" {{#if (eq config.meleeBonusMode "attribute")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.MeleeBonusMode.Attribute"}}</option>
                    <option value="skill" {{#if (eq config.meleeBonusMode "skill")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.MeleeBonusMode.Skill"}}</option>
                    <option value="both" {{#if (eq config.meleeBonusMode "both")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.MeleeBonusMode.Both"}}</option>
                </select>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.MeleeBonusMode.Hint"}}</p>
        </div>

        <div class="unarmed-damage-config">
            <h4>{{localize "NEUROSHIMA.Settings.UnarmedDamage.Title"}}</h4>
            <div class="unarmed-damage-actions">
                <button type="button" data-action="addUnarmedThreshold"><i class="fas fa-plus"></i> {{localize "NEUROSHIMA.Settings.UnarmedDamage.Add"}}</button>
                <button type="button" data-action="resetUnarmedThresholds"><i class="fas fa-rotate-left"></i> {{localize "NEUROSHIMA.Settings.UnarmedDamage.Reset"}}</button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>{{localize "NEUROSHIMA.Settings.UnarmedDamage.BuildTo"}}</th>
                        <th>{{localize "NEUROSHIMA.Settings.UnarmedDamage.Success1"}}</th>
                        <th>{{localize "NEUROSHIMA.Settings.UnarmedDamage.Success2"}}</th>
                        <th>{{localize "NEUROSHIMA.Settings.UnarmedDamage.Success3"}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each unarmedDamageTable}}
                    <tr data-unarmed-row="{{index}}">
                        <td><input type="number" name="unarmedDamageTable.{{index}}.maxBuild" value="{{maxBuildValue}}" placeholder="∞"></td>
                        <td><select name="unarmedDamageTable.{{index}}.damage1">{{#each damageChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></td>
                        <td><select name="unarmedDamageTable.{{index}}.damage2">{{#each damage2Choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></td>
                        <td><select name="unarmedDamageTable.{{index}}.damage3">{{#each damage3Choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></td>
                        <td><button type="button" data-action="removeUnarmedThreshold" data-tooltip="{{localize 'NEUROSHIMA.Actions.Delete'}}"><i class="fas fa-trash"></i></button></td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="config-section">
        <h3>{{localize "NEUROSHIMA.Settings.CombatConfig.VisibilityTitle"}}</h3>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.DamageApplicationMinRole.Name"}}</label>
            <div class="form-fields">
                <select name="damageApplicationMinRole">
                    {{#each roleOptions}}
                    <option value="{{@key}}" {{#if (eq (number @key) ../config.damageApplicationMinRole)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.DamageApplicationMinRole.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.PainResistanceMinRole.Name"}}</label>
            <div class="form-fields">
                <select name="painResistanceMinRole">
                    {{#each roleOptions}}
                    <option value="{{@key}}" {{#if (eq (number @key) ../config.painResistanceMinRole)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.PainResistanceMinRole.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.CombatActionsMinRole.Name"}}</label>
            <div class="form-fields">
                <select name="combatActionsMinRole">
                    {{#each roleOptions}}
                    <option value="{{@key}}" {{#if (eq (number @key) ../config.combatActionsMinRole)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.CombatActionsMinRole.Hint"}}</p>
        </div>

        <div class="form-group">
            <label>{{localize "NEUROSHIMA.Settings.UnjamMinRole.Name"}}</label>
            <div class="form-fields">
                <select name="unjamMinRole">
                    {{#each roleOptions}}
                    <option value="{{@key}}" {{#if (eq (number @key) ../config.unjamMinRole)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="notes">{{localize "NEUROSHIMA.Settings.UnjamMinRole.Hint"}}</p>
        </div>
    </div>
    <div class="config-section">
        <h3>{{localize "NEUROSHIMA.ArmorLimit.Name"}}</h3>
        <div class="form-group">
            <label>{{localize "NEUROSHIMA.ArmorLimit.Name"}}</label>
            <div class="form-fields"><input type="checkbox" name="armorLimitEnabled" {{checked config.armorLimitEnabled}}></div>
            <p class="notes">{{localize "NEUROSHIMA.ArmorLimit.Hint"}}</p>
        </div>
        <div class="armor-limit-config" data-armor-limit-table {{#unless config.armorLimitEnabled}}hidden{{/unless}}>
            <table>
                <thead>
                    <tr>
                        <th scope="col">{{localize "NEUROSHIMA.ArmorLimit.Character"}}</th>
                        <th scope="col">{{localize "NEUROSHIMA.ArmorLimit.Creature"}}</th>
                        <th scope="col">{{localize "NEUROSHIMA.ArmorLimit.Vehicle"}}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="number" name="armorLimitCharacter" value="{{config.armorLimitCharacter}}" min="0" step="0.5" required aria-label="{{localize 'NEUROSHIMA.ArmorLimit.Character'}}"></td>
                        <td><input type="number" name="armorLimitCreature" value="{{config.armorLimitCreature}}" min="0" step="0.5" required aria-label="{{localize 'NEUROSHIMA.ArmorLimit.Creature'}}"></td>
                        <td><input type="number" name="armorLimitVehicle" value="{{config.armorLimitVehicle}}" min="0" step="0.5" required aria-label="{{localize 'NEUROSHIMA.ArmorLimit.Vehicle'}}"></td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
    <div class="config-section armor-durability-config">
        <h3>{{localize "NEUROSHIMA.Settings.ArmorDurability.Title"}}</h3>
        <div class="armor-durability-options">
            <div class="armor-durability-column">
                <label class="armor-durability-toggle">
                    <span>{{localize "NEUROSHIMA.Settings.ArmorDurability.Melee"}}</span>
                    <input type="checkbox" name="armorDurabilityMelee" {{checked config.armorDurabilityMelee}}>
                </label>
                <label class="armor-durability-toggle" title="{{localize 'NEUROSHIMA.Settings.ArmorDurability.BruisesHint'}}">
                    <span>{{localize "NEUROSHIMA.Settings.ArmorDurability.Bruises"}}</span>
                    <input type="checkbox" name="armorDurabilityMeleeBruises" {{checked config.armorDurabilityMeleeBruises}} {{#unless config.armorDurabilityMelee}}disabled{{/unless}}>
                </label>
            </div>
            <div class="armor-durability-column">
                <label class="armor-durability-toggle">
                    <span>{{localize "NEUROSHIMA.Settings.ArmorDurability.Ranged"}}</span>
                    <input type="checkbox" name="armorDurabilityRanged" {{checked config.armorDurabilityRanged}}>
                </label>
                <select name="armorDurabilityRangedTiming" aria-label="{{localize 'NEUROSHIMA.Settings.ArmorDurability.Timing'}}" title="{{localize 'NEUROSHIMA.Settings.ArmorDurability.Timing'}}" {{#unless config.armorDurabilityRanged}}disabled{{/unless}}>
                    <option value="beforeArmor" {{#if (eq config.armorDurabilityRangedTiming "beforeArmor")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.ArmorDurability.Before"}}</option>
                    <option value="afterArmor" {{#if (eq config.armorDurabilityRangedTiming "afterArmor")}}selected{{/if}}>{{localize "NEUROSHIMA.Settings.ArmorDurability.After"}}</option>
                </select>
            </div>
        </div>
        <p class="notes">{{localize "NEUROSHIMA.Settings.ArmorDurability.Hint"}}</p>
    </div>
    {{> "systems/neuroshima/templates/apps/damage-category-config.hbs"}}
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="fas fa-save"></i> {{localize "NEUROSHIMA.Actions.Save"}}
        </button>
    </footer>
</section>
