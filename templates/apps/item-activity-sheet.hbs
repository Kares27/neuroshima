<header class="item-activity-header">
  <button type="button" class="activity-image" data-action="pickImage"><img src="{{activity.img}}" alt=""></button>
  <div><small>{{activityType.label}}</small><h2>{{activity.name}}</h2></div>
  <button type="button" data-action="useActivity"><i class="fa-solid fa-play"></i> Użyj</button>
</header>

<nav class="item-activity-tabs">
  {{#each tabs}}
  <button type="button" data-action="tab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">
    {{#if (eq id "identity")}}Tożsamość{{else if (eq id "activation")}}Aktywacja{{else}}Efekt{{/if}}
  </button>
  {{/each}}
</nav>

<main class="activity-sheet-body">
  <section data-activity-panel="identity">
    <fieldset><legend>Tożsamość</legend>
      <label><span>Nazwa</span><input name="name" value="{{activity.name}}"></label>
      <label><span>Ikona</span><input name="img" value="{{activity.img}}"></label>
      <label><span>Widoczność</span><select name="visibility"><option value="public" {{#if (eq activity.visibility "public")}}selected{{/if}}>Publiczna</option><option value="owner" {{#if (eq activity.visibility "owner")}}selected{{/if}}>Właściciel</option><option value="gm" {{#if (eq activity.visibility "gm")}}selected{{/if}}>MG</option></select></label>
      <label class="stack"><span>Opis</span><textarea name="description" rows="7">{{activity.description}}</textarea></label>
      <label class="stack"><span>Tekst na czacie</span><textarea name="chatText" rows="4">{{activity.chatText}}</textarea></label>
    </fieldset>
  </section>

  <section data-activity-panel="activation" hidden>
    <nav class="activity-activation-tabs">
      {{#each activationTabs}}
      <button type="button" data-action="activationTab" data-activation-tab="{{id}}" class="{{#if active}}active{{/if}}">
        {{#if (eq id "time")}}Czas{{else if (eq id "consumption")}}Zużycie{{else}}Celowanie{{/if}}
      </button>
      {{/each}}
    </nav>

    <div data-activation-panel="time">
      <fieldset><legend>Czas</legend>
        <label><span>Aktywacja</span><select name="activation.type"><option value="manual" selected>Ręczna</option></select></label>
      </fieldset>
    </div>

    <div data-activation-panel="consumption" hidden>
      <fieldset><legend>Własne użycia</legend>
      <div class="activity-uses-grid">
        <label><span>Maksimum</span><input type="number" min="0" name="uses.max" value="{{activity.uses.max}}" placeholder="Bez limitu"></label>
        <label><span>Wydano</span><input type="number" min="0" name="uses.spent" value="{{activity.uses.spent}}"></label>
        <div class="activity-remaining"><span>Pozostało</span><strong>{{#if (eq remaining null)}}∞{{else}}{{remaining}}{{/if}}</strong></div>
      </div>
        <label><span>Odnawianie</span><select disabled><option>Ręcznie</option></select></label>
      </fieldset>
      <fieldset><legend>Wspólne użycia Itemu</legend>
      <div class="activity-uses-grid">
        <label><span>Maksimum</span><input type="number" min="0" name="itemUses.max" value="{{itemUses.max}}" placeholder="Bez limitu"></label>
        <label><span>Wydano</span><input type="number" min="0" name="itemUses.spent" value="{{itemUses.spent}}"></label>
      </div>
      </fieldset>
      <fieldset><legend>Zużycie <button type="button" data-action="addConsumption"><i class="fa-solid fa-plus"></i></button></legend>
      {{#each consumption}}
      <div class="activity-consumption-row">
        <select name="consumption.{{index}}.type">
          {{#each types}}<option value="{{type}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <select name="consumption.{{index}}.target" {{#unless isItemResource}}disabled{{/unless}}>
          <option value="">—</option>
          {{#each ../resources}}<option value="{{id}}" {{#if (eq id ../target)}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <input type="number" min="0" name="consumption.{{index}}.value" value="{{value}}">
        <button type="button" data-action="removeConsumption" data-index="{{index}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{else}}<p class="hint">Ta Activity nie zużywa żadnego zasobu.</p>{{/each}}
      </fieldset>
    </div>

    <div data-activation-panel="targeting" hidden>
      <fieldset><legend>Celowanie</legend>
        <label><span>Cel</span><select name="activation.target">
          <option value="self" {{#if (eq activity.activation.target "self")}}selected{{/if}}>Wykonujący</option>
          <option value="selected" {{#if (eq activity.activation.target "selected")}}selected{{/if}}>Zaznaczone cele</option>
          <option value="manual" {{#if (eq activity.activation.target "manual")}}selected{{/if}}>Ręczny</option>
        </select></label>
      </fieldset>
    </div>
  </section>

  <section data-activity-panel="effect" hidden>
    <fieldset><legend>Applied Effects</legend>
      <label><span>Działanie</span><select name="effectOperation">
        <option value="apply" {{#if effectOperationApply}}selected{{/if}}>Nałóż wybrane efekty</option>
        <option value="remove" {{#if effectOperationRemove}}selected{{/if}}>Usuń efekty nałożone przez tę Activity</option>
      </select></label>
      <div class="activity-effect-list">
      {{#each effects}}
        <label><input type="checkbox" name="effects" value="{{id}}" {{checked selected}}><img src="{{img}}" alt=""><span>{{name}}</span></label>
      {{else}}<p class="hint">Najpierw dodaj Active Effect do nadrzędnego Itemu.</p>{{/each}}
      </div>
    </fieldset>

    {{#if isUse}}
    <fieldset><legend>Użycie</legend>
      <p class="hint">Po zużyciu zasobów Activity publikuje kartę i stosuje wybrane efekty.</p>
      <label class="activity-checkbox"><input type="checkbox" name="roll.enabled" {{checked activity.roll.enabled}}><span>Wykonaj prosty rzut</span></label>
      <label><span>Formuła</span><input name="roll.formula" value="{{activity.roll.formula}}" placeholder="1d20"></label>
    </fieldset>
    {{/if}}

    {{#if isTest}}
    <fieldset><legend>Konfiguracja testu</legend>
      <label><span>Rodzaj</span><select name="test.kind"><option value="attribute" {{#if (eq activity.test.kind "attribute")}}selected{{/if}}>Współczynnik</option><option value="skill" {{#if (eq activity.test.kind "skill")}}selected{{/if}}>Umiejętność</option></select></label>
      <label><span>Współczynnik</span><select name="test.attributeKey">{{#each attributes}}<option value="{{key}}" {{#if (eq key ../activity.test.attributeKey)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label><span>Umiejętność</span><select name="test.skillKey"><option value="">—</option>{{#each skills}}<option value="{{key}}" {{#if (eq key ../activity.test.skillKey)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label><span>Trudność</span><select name="test.difficulty">{{#each difficulties}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="activity-checkbox"><input type="checkbox" name="test.isOpen" {{checked activity.test.isOpen}}><span>Test otwarty</span></label>
    </fieldset>
    {{/if}}

    {{#if (or isDamage isAttack)}}
    <fieldset><legend>Konfiguracja obrażeń</legend>
      <label><span>Obrażenia</span><select name="damage.damageType">{{#each damageTypes}}<option value="{{this}}" {{#if (eq this ../activity.damage.damageType)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><span>Kategoria</span><select name="damage.damageCategory">{{#each damageCategories}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label><span>Lokacja</span><select name="damage.location">{{#each locations}}<option value="{{key}}" {{#if (eq key ../activity.damage.location)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label><span>Przebicie</span><input type="number" min="0" name="damage.piercing" value="{{activity.damage.piercing}}"></label>
      <label class="activity-checkbox"><input type="checkbox" name="damage.withPainResistance" {{checked activity.damage.withPainResistance}}><span>Rzut odporności na ból</span></label>
    </fieldset>
    {{/if}}

    {{#if isAttack}}
    <fieldset><legend>Konfiguracja ataku</legend>
      <label><span>Tryb</span><select name="attack.mode">
        <option value="melee" {{#if (eq activity.attack.mode "melee")}}selected{{/if}}>Wręcz</option>
        <option value="ranged" {{#if (eq activity.attack.mode "ranged")}}selected{{/if}}>Dystansowy</option>
        <option value="thrown" {{#if (eq activity.attack.mode "thrown")}}selected{{/if}}>Rzucany</option>
        <option value="grenade" {{#if (eq activity.attack.mode "grenade")}}selected{{/if}}>Granat</option>
      </select></label>
    </fieldset>
    {{/if}}
  </section>
</main>

<footer class="item-activity-footer">
  <button type="button" class="danger" data-action="deleteActivity"><i class="fa-solid fa-trash"></i> Usuń</button>
  <button type="submit"><i class="fa-solid fa-floppy-disk"></i> Zapisz</button>
</footer>
